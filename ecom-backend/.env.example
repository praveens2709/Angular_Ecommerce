# Copy to .env and fill in. Never commit the real .env.

# --- Required ---
PORT=4000
# Atlas database user (not your Atlas login). URL-encode special characters, e.g. @ -> %40
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/?appName=Cluster0
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# --- Sessions ---
USER_TOKEN_EXPIRY=7d
ADMIN_TOKEN_EXPIRY=12h

# --- URLs ---
# Storefront URL, used in email links (order tracking, password reset)
CLIENT_URL=http://localhost:4200
# Public URL of this API, used for uploaded image links (defaults to the request host)
PUBLIC_URL=
# Comma-separated origins allowed to call the API; leave empty to allow all (dev only)
CLIENT_ORIGINS=

# --- Email (order confirmations, status updates, password reset) ---
# Leave SMTP_HOST empty in development: emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DopeShope <no-reply@yourdomain.com>

# --- Business details (policy pages, Contact page, invoices). Fill these before launch ---
STORE_NAME=DopeShope
STORE_LEGAL_NAME=
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
STORE_CITY=
# Warehouse state + pincode also drive delivery-time estimates and CGST/SGST vs IGST on invoices
STORE_STATE=
STORE_PINCODE=
STORE_GSTIN=
STORE_SUPPORT_HOURS=Mon–Sat, 10am–6pm IST

# --- Invoices / GST (prices are GST-inclusive; confirm rates with your accountant) ---
INVOICE_PREFIX=DS
GST_RATE_LOW=5
GST_RATE_HIGH=18
# Per-piece price above which the high rate applies
GST_THRESHOLD=2500
# HSN code printed on invoices (e.g. 6109 for T-shirts); leave empty to omit the column
DEFAULT_HSN=

# --- Image storage ---
# Cloudinary (recommended in production): cloudinary://<api_key>:<api_secret>@<cloud_name>
# Without it, uploads are resized to WebP and saved in ./uploads (lost on hosts with ephemeral disks)
CLOUDINARY_URL=
CLOUDINARY_FOLDER=dopeshope/products

# --- Storefront rebuilds (Cloudflare Pages) ---
# Deploy hook URL: product/category changes rebuild the pre-rendered storefront automatically
SITE_REBUILD_HOOK_URL=
# Wait after the last change before rebuilding, in ms (a burst of edits = one rebuild)
SITE_REBUILD_DELAY_MS=90000

# --- Delivery ---
# Comma-separated pincodes you can't deliver to
NON_SERVICEABLE_PINCODES=
# Set to "off" to skip the India Post pincode lookup (e.g. offline)
PINCODE_LOOKUP=

# --- Misc ---
NODE_ENV=production
# Timezone for dashboard day buckets (defaults to the server's timezone)
SHOP_TIMEZONE=Asia/Kolkata
# Raise the login/reset rate limit per IP (default 10 logins / 5 resets per 15 min)
AUTH_RATE_LIMIT_MAX=
